# ==============================================================================
# Academic Research Skills (ARS) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before launching the application:
#   Copy-Item .env.example .env
#
# Replace the placeholder values with your personal credentials.
# Do NOT commit your real .env file or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Nexus AI Gateway Configuration (Required)
# ------------------------------------------------------------------------------
# Base URL for the Nexus AI LiteLLM Gateway
ANTHROPIC_BASE_URL=https://nexusapi.navigatelabs.ai

# Your Nexus virtual API key (must begin with "sk-")
# Obtain this key from your Nexus AI Model Hub account
ANTHROPIC_AUTH_TOKEN=your_nexus_api_key_here

# Active model identifier routed through Nexus AI
# e.g., claude-haiku-4-5 (pinned: claude-haiku-4-5-20251001) or your gateway route
ANTHROPIC_MODEL=claude-haiku-4-5

# Maximum token limit for Claude Code CLI output
CLAUDE_CODE_MAX_OUTPUT_TOKENS=4096

# ------------------------------------------------------------------------------
# 2. Optional Literature Search & Academic API Keys
# ------------------------------------------------------------------------------
# Semantic Scholar API Key (optional - increases search rate limits)
# SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key

# OpenAlex contact email (optional - grants access to the faster Polite Pool)
# OPENALEX_EMAIL=your_email@institution.edu

# Crossref Plus API Token (optional)
# CROSSREF_PLUS_API_TOKEN=your_crossref_token
